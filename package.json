{
  "name": "drucktool",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm build:scripts",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts scripts/mail-worker.ts --bundle --platform=node --format=esm --target=node22 --outdir=.output/scripts --out-extension:.js=.mjs --log-level=warning && esbuild src/server/files/pdf-worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=.output/scripts/pdf-worker.mjs --log-level=warning",
    "mail:worker": "tsx --env-file-if-exists=.env scripts/mail-worker.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^9.2.4",
    "drizzle-orm": "^0.45.3",
    "nodemailer": "^10.0.13",
    "openid-client": "^6.8.8",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "nitro": "3.0.260903-beta",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "smtp-server": "^3.19.16",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.9"
  },
  "packageManager": "pnpm@10.33.0"
}
