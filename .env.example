DATABASE_URL=postgres://drucktool:drucktool@localhost:5432/drucktool
# Öffentliche URL der Anwendung (für Links in E-Mails)
APP_URL=http://localhost:3000
# Auf "false" setzen, wenn die Anwendung ohne HTTPS betrieben wird (nur lokal!)
COOKIE_SECURE=false
# Erster Superadmin (wird von "pnpm db:seed" angelegt, falls keiner existiert)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=bitte-aendern-123
# Hinter einem Reverse Proxy (z. B. Traefik/nginx) auf true setzen, damit X-Forwarded-For genutzt wird
TRUST_PROXY=false
# E-Mail-Versand (SMTP). Ohne SMTP_URL werden Mails nur ins Log geschrieben.
# Beispiele: smtps://benutzer:passwort@mail.example.com:465 oder smtp://benutzer:passwort@mail.example.com:587
SMTP_URL=
MAIL_FROM="Druckerei Muster <auftraege@example.com>"
