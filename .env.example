DATABASE_URL=postgres://drucktool:drucktool@localhost:5432/drucktool
# Öffentliche URL der Anwendung (für Links in E-Mails)
APP_URL=http://localhost:3000
# Auf "false" setzen, wenn die Anwendung ohne HTTPS betrieben wird (nur lokal!)
COOKIE_SECURE=false
# Erster Superadmin (wird von "pnpm db:seed" angelegt, falls keiner existiert)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=bitte-aendern-123
# Optional: neue Kundenkonten per Anmeldelink nur für diese Domains (kommagetrennt), z. B. tum.de
CUSTOMER_EMAIL_DOMAINS=
# Hinter einem Reverse Proxy (z. B. Traefik/nginx) auf true setzen, damit X-Forwarded-For genutzt wird
TRUST_PROXY=false
# E-Mail-Versand (SMTP). Ohne SMTP_URL werden Mails nur ins Log geschrieben.
# Beispiele: smtps://benutzer:passwort@mail.example.com:465 oder smtp://benutzer:passwort@mail.example.com:587
SMTP_URL=
MAIL_FROM="Druckerei Muster <auftraege@example.com>"
# Testsystem: alle Mails an diese Adresse statt an die echten Empfänger (Empfänger steht im Betreff)
MAIL_REDIRECT_TO=
# production, staging (zeigt das Banner "Testsystem") oder development
APP_ENVIRONMENT=
# Ablage für hochgeladene Druckdateien (Standard: data/uploads) und größte erlaubte Datei in MB
UPLOAD_DIR=
UPLOAD_MAX_MB=500
# Anhänge an Nachrichten: größte Datei in MB und erlaubte Endungen (leer = Standardliste)
ATTACHMENT_MAX_MB=25
ATTACHMENT_TYPES=
# Aufbewahrung des Audit-Logs in Tagen (0 = unbegrenzt); der Worker löscht ältere Einträge
AUDIT_LOG_RETENTION_DAYS=365
# Löschfristen in Tagen (0 = nie): IP-Adressen an Sitzungen, abgelehnte Registrierungen
SESSION_IP_RETENTION_DAYS=30
REJECTED_REGISTRATION_RETENTION_DAYS=30
# Links in der Fußzeile (leer = nicht anzeigen)
PRIVACY_URL=
IMPRINT_URL=
# Anmeldung über OpenID Connect (optional). Redirect-URI beim Anbieter: <APP_URL>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Beschriftung des Buttons: "Anmelden mit ..."
OIDC_DISPLAY_NAME=Firmenkonto
# Unbekannte Benutzer: pending (Registrierung, Superadmin gibt frei), staff (direkt als Mitarbeiter), reject
OIDC_NEW_USERS=pending
# true, wenn der Anbieter kein email_verified liefert, seinen Adressen aber vertraut werden kann (z. B. Entra ID)
OIDC_TRUST_EMAIL=false
# Rollen vom Anbieter übernehmen (z. B. Entra-App-Rollen). Leer lassen, um Rollen nur im Drucktool zu pflegen.
OIDC_ROLE_CLAIM=roles
OIDC_ADMIN_ROLES=
OIDC_STAFF_ROLES=
# true: Mitarbeiter und Admins können sich nicht mehr mit Passwort anmelden (Superadmin bleibt Notfallzugang)
OIDC_ENFORCE_FOR_STAFF=false
