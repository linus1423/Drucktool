# Verwaltet von Ansible – Änderungen hier werden überschrieben.
# Einfache Anführungszeichen verhindern, dass Docker Compose "$" in Passwörtern auswertet.
POSTGRES_PASSWORD='{{ drucktool_postgres_password }}'
DATABASE_URL='postgres://drucktool:{{ drucktool_postgres_password | urlencode }}@db:5432/drucktool'
APP_URL={{ ('https://' ~ drucktool_domain) if drucktool_domain else 'http://' ~ ansible_host ~ ':3000' }}
COOKIE_SECURE={{ 'true' if drucktool_domain else 'false' }}
TRUST_PROXY={{ 'true' if drucktool_domain else 'false' }}
SUPERADMIN_EMAIL={{ drucktool_superadmin_email }}
SUPERADMIN_PASSWORD='{{ drucktool_superadmin_password | default('') }}'
SMTP_URL='{{ drucktool_smtp_url }}'
MAIL_FROM='{{ drucktool_mail_from }}'
{% if drucktool_oidc_issuer %}
OIDC_ISSUER='{{ drucktool_oidc_issuer }}'
OIDC_CLIENT_ID='{{ drucktool_oidc_client_id }}'
OIDC_CLIENT_SECRET='{{ drucktool_oidc_client_secret }}'
OIDC_DISPLAY_NAME='{{ drucktool_oidc_display_name }}'
OIDC_NEW_USERS={{ drucktool_oidc_new_users }}
OIDC_TRUST_EMAIL={{ 'true' if drucktool_oidc_trust_email else 'false' }}
{% endif %}
