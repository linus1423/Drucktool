# Verwaltet von Ansible – Änderungen hier werden überschrieben.

# Logs je Container begrenzen (höchstens max-file Dateien zu je max-size), damit sie die Platte nicht füllen.
x-logging: &logging
  driver: json-file
  options:
    max-size: '{{ drucktool_log_max_size }}'
    max-file: '{{ drucktool_log_max_files }}'

services:
  db:
    image: postgres:16-alpine
    logging: *logging
    restart: unless-stopped
    environment:
      POSTGRES_DB: drucktool
      POSTGRES_USER: drucktool
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U drucktool -d drucktool']
      interval: 5s
      timeout: 5s
      retries: 10

  app:
    image: {{ drucktool_image }}:{{ drucktool_image_tag }}
    logging: *logging
    restart: unless-stopped
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
{% if drucktool_clamav_enabled %}
      # Nur Startreihenfolge, nicht auf "healthy" warten: der erste Download der Signaturen dauert einige Minuten.
      # Bis clamd bereit ist, lehnt die App Uploads mit einem Hinweis ab.
      clamav:
        condition: service_started
{% endif %}
    volumes:
      # Hochgeladene Druckdateien, gehört dem Benutzer node (UID 1000) im Container.
      - ./uploads:/app/uploads
    ports:
{% if drucktool_domain or not drucktool_expose_app_port %}
      # Nur auf dem Server erreichbar{{ ', Caddy übernimmt HTTPS' if drucktool_domain else ' (ohne Domain z. B. per SSH-Tunnel)' }}.
      # Docker umgeht die Firewall, deshalb nie ohne 127.0.0.1 veröffentlichen.
      - '127.0.0.1:3000:3000'
{% else %}
      # drucktool_expose_app_port: ohne HTTPS aus dem Internet erreichbar.
      - '3000:3000'
{% endif %}

  # Verschickt E-Mails aus der Outbox.
  worker:
    image: {{ drucktool_image }}:{{ drucktool_image_tag }}
    command: worker
    logging: *logging
    restart: unless-stopped
    env_file: .env
    depends_on:
      app:
        condition: service_healthy
    healthcheck:
      disable: true
{% if drucktool_clamav_enabled %}

  # Virenscanner für Uploads (Issue #99, #120). Nicht von außen erreichbar, nur im Compose-Netz.
  # freshclam im Container hält die Signaturen aktuell.
  clamav:
    image: {{ drucktool_clamav_image }}
    logging: *logging
    restart: unless-stopped
    environment:
      # Ohne diese Grenzen prüft clamd nur die ersten 25 MB bzw. lässt große Dateien ungeprüft durch.
      CLAMD_CONF_StreamMaxLength: '{{ drucktool_upload_max_mb }}M'
      CLAMD_CONF_MaxFileSize: '{{ drucktool_upload_max_mb }}M'
      CLAMD_CONF_MaxScanSize: '{{ drucktool_upload_max_mb }}M'
    volumes:
      # Signaturen bleiben über Neustarts und Updates erhalten.
      - clamav-db:/var/lib/clamav
    healthcheck:
      # clamdcheck.sh liegt im Image und fragt clamd per PING ab.
      test: ['CMD', 'clamdcheck.sh']
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10m
{% endif %}
{% if drucktool_domain %}

  caddy:
    image: caddy:2-alpine
    logging: *logging
    restart: unless-stopped
    depends_on: [app]
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
{% endif %}

volumes:
  db-data:
{% if drucktool_clamav_enabled %}
  clamav-db:
{% endif %}
{% if drucktool_domain %}
  caddy-data:
  caddy-config:
{% endif %}
