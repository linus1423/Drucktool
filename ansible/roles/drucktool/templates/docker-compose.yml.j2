# Verwaltet von Ansible – Änderungen hier werden überschrieben.
services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: drucktool
      POSTGRES_USER: drucktool
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U drucktool -d drucktool']
      interval: 5s
      timeout: 5s
      retries: 10

  app:
    image: {{ drucktool_image }}:{{ drucktool_image_tag }}
    restart: unless-stopped
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
    ports:
{% if drucktool_domain %}
      # Nur lokal erreichbar, Caddy übernimmt HTTPS.
      - '127.0.0.1:3000:3000'
{% else %}
      - '3000:3000'
{% endif %}
{% if drucktool_domain %}

  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on: [app]
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
{% endif %}

volumes:
  db-data:
{% if drucktool_domain %}
  caddy-data:
  caddy-config:
{% endif %}
