# Verwaltet von Ansible. Zugang zum Offsite-Backup (restic). Ohne RESTIC_PASSWORD sind die Backups nicht lesbar –
# das Passwort deshalb zusätzlich außerhalb des Servers aufbewahren (Passwortmanager der FSMB-IT).
RESTIC_REPOSITORY='{{ drucktool_restic_repository }}'
RESTIC_PASSWORD='{{ drucktool_restic_password }}'
{% for key, value in drucktool_restic_env.items() %}
{{ key }}='{{ value }}'
{% endfor %}
